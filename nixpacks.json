{
  "phases": {
    "setup": {
      "nixPkgs": ["...", "php82Extensions.gd", "php82Extensions.zip"]
    },
    "build": {
      "cmds": [
        "composer install --optimize-autoloader --no-interaction --ignore-platform-req=ext-gd"
      ]
    }
  },
  "phpExtensions": [
    "gd",
    "zip",
    "pdo",
    "pdo_mysql",
    "mbstring"
  ]
